  code: '<path d="M9 18l-6-6 6-6M15 6l6 6-6 6" />',
  'file-text':
    '<path d="M14 3v5h5" /><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M9 13h6M9 17h4" />',
  presentation: '<path d="M3 4h18M4.5 4v9.5a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V4M9 20l3-4 3 4" />',
