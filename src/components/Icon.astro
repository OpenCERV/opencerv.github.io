---
/**
 * Inline SVG icons.
 *
 * Hand-rolled rather than pulling in an icon package: the site uses a small,
 * fixed set, and inlining keeps them stylable with `currentColor` and costs no
 * extra request or dependency.
 *
 * Decorative by default (`aria-hidden`). Pass a `label` when an icon carries
 * meaning that is not already available as adjacent text.
 */
interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const STROKE_ICONS = {
