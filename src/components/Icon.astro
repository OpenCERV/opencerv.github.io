  shield:
    '<path d="M12 3l7 3v5.2c0 4.4-2.9 7.9-7 9.8-4.1-1.9-7-5.4-7-9.8V6l7-3z" /><path d="M9.2 12.2l1.9 1.9 3.7-3.8" />',
  lock: '<rect x="4" y="10.5" width="16" height="9.5" rx="2" /><path d="M7.5 10.5V7.8a4.5 4.5 0 0 1 9 0v2.7" />',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />',
  'map-pin':
    '<path d="M12 21.5s7-5.9 7-11.5a7 7 0 1 0-14 0c0 5.6 7 11.5 7 11.5z" /><circle cx="12" cy="10" r="2.5" />',
  users:
    '<circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16.2 5.3a3.5 3.5 0 0 1 0 5.4M17.8 14.4A6.5 6.5 0 0 1 21.5 20" />',
  'book-open':
    '<path d="M12 7.5v12.8M12 7.5C10.4 6 8.4 5.4 6 5.4H3v12h3c2.4 0 4.4.6 6 2.1M12 7.5c1.6-1.5 3.6-2.1 6-2.1h3v12h-3c-2.4 0-4.4.6-6 2.1" />',
  build:
    '<path d="M12 3l8 4.4v9.2L12 21l-8-4.4V7.4L12 3z" /><path d="M4 7.4l8 4.4 8-4.4M12 11.8V21" />',
  globe:
