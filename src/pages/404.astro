---
import Button from '../components/Button.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page does not exist." noindex>
  <div class="mx-auto flex max-w-2xl flex-col items-start px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <p class="font-mono text-sm font-semibold tracking-[0.16em] text-crimson-700 uppercase">
      Error 404
    </p>
    <h1 class="mt-3 text-3xl sm:text-4xl">This page does not exist</h1>
    <p class="mt-5 text-lg text-muted">
      The link may be out of date, or the page may have moved. The sections below cover everything
      on the site.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" iconAfter="arrow-right">
        Back to home
      </Button>
      <Button href="/activities" variant="secondary">
        Activities
      </Button>
      <Button href="/projects" variant="secondary">
        Projects
      </Button>
      <Button href={site.github.url} variant="secondary" icon="github">
        OpenCERV
      </Button>
    </div>
  </div>
</BaseLayout>
